CREATE VIEW monthly_revenue AS
WITH monthly AS (
    SELECT
        DATE_TRUNC('month', o.order_purchase_timestamp) AS month,
        SUM(p.payment_value) AS revenue
    FROM orders o
    JOIN payments p ON o.order_id = p.order_id
    WHERE o.order_status = 'delivered'
    GROUP BY 1
)
SELECT
    month,
    revenue,
    LAG(revenue) OVER (ORDER BY month) AS prev_month_revenue,
    ROUND(
        (revenue - LAG(revenue) OVER (ORDER BY month)) /
        NULLIF(LAG(revenue) OVER (ORDER BY month), 0) * 100, 2
    ) AS mom_growth_pct
FROM monthly
ORDER BY month;

CREATE VIEW cohort_retention AS
WITH first_order AS (
    SELECT
        customer_unique_id,
        DATE_TRUNC('month', MIN(o.order_purchase_timestamp)) AS cohort_month
    FROM orders o
    JOIN customers c ON o.customer_id = c.customer_id
    GROUP BY 1
),
order_months AS (
    SELECT
        c.customer_unique_id,
        DATE_TRUNC('month', o.order_purchase_timestamp) AS order_month
    FROM orders o
    JOIN customers c ON o.customer_id = c.customer_id
)
SELECT
    f.cohort_month,
    EXTRACT(EPOCH FROM (om.order_month - f.cohort_month))/2592000 AS months_since_first,
    COUNT(DISTINCT f.customer_unique_id) AS cohort_size,
    COUNT(DISTINCT om.customer_unique_id) AS retained
FROM first_order f
JOIN order_months om ON f.customer_unique_id = om.customer_unique_id
GROUP BY 1, 2
ORDER BY 1, 2;

CREATE VIEW seller_ranking AS
SELECT
    oi.seller_id,
    COUNT(DISTINCT oi.order_id) AS total_orders,
    ROUND(SUM(oi.price)::numeric, 2) AS total_revenue,
    ROUND(AVG(r.review_score)::numeric, 2) AS avg_review_score,
    DENSE_RANK() OVER (ORDER BY SUM(oi.price) DESC) AS revenue_rank
FROM order_items oi
JOIN reviews r ON oi.order_id = r.order_id
GROUP BY oi.seller_id
ORDER BY revenue_rank;

CREATE VIEW delivery_delay_by_state AS
SELECT
    c.customer_state,
    COUNT(*) AS total_orders,
    ROUND(AVG(
        EXTRACT(EPOCH FROM (
            o.order_delivered_customer_date - o.order_estimated_delivery_date
        )) / 86400
    )::numeric, 2) AS avg_delay_days
FROM orders o
JOIN customers c ON o.customer_id = c.customer_id
WHERE o.order_delivered_customer_date IS NOT NULL
  AND o.order_estimated_delivery_date IS NOT NULL
GROUP BY c.customer_state
ORDER BY avg_delay_days DESC;

